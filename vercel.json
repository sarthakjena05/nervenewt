{
  "routes": [
    {
      "src": "^/docs/?$",
      "missing": [{ "type": "host", "value": "docs.nervenewt.com" }],
      "status": 308,
      "headers": { "Location": "https://docs.nervenewt.com/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "docs.nervenewt.com" }],
      "dest": "/docs/index.html"
    }
  ]
}
